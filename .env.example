# .env.example

# Gemini AI API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Paystack Payment (Get from https://dashboard.paystack.com/#/settings/developer)
VITE_PAYSTACK_PUBLIC_KEY=

# EmailJS (Get from https://dashboard.emailjs.com/)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_WELCOME_TEMPLATE_ID=
VITE_EMAILJS_TEMPLATE_ID=
