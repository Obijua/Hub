{
  "redirects": [
    {
      "source": "/category/udemy-coupon",
      "destination": "/category/courses-",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/post/:slug",
      "destination": "/api/page?type=post&slug=:slug"
    },
    {
      "source": "/category/:slug",
      "destination": "/api/page?type=category&slug=:slug"
    },
    {
      "source": "/jobs/:jobId",
      "destination": "/api/page?type=job&id=:jobId"
    },
    {
      "source": "/about",
      "destination": "/api/page?type=static&path=/about"
    },
    {
      "source": "/contact",
      "destination": "/api/page?type=static&path=/contact"
    },
    {
      "source": "/jobs",
      "destination": "/api/page?type=static&path=/jobs"
    },
    {
      "source": "/blog",
      "destination": "/api/page?type=static&path=/blog"
    },
    {
      "source": "/documents",
      "destination": "/api/page?type=static&path=/documents"
    },
    {
      "source": "/documents/cv",
      "destination": "/api/page?type=static&path=/documents/cv"
    },
    {
      "source": "/privacy-policy",
      "destination": "/api/page?type=static&path=/privacy-policy"
    },
    {
      "source": "/disclaimer",
      "destination": "/api/page?type=static&path=/disclaimer"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
